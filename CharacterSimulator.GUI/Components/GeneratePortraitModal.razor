@using CharacterSimulator.Logic
@using CharacterSimulator.Logic.Services
@inject TurnControlContext ControlContext
@inject IJSRuntime JS

<div class="modal-overlay">
    <div class="modal-card" style="width: 560px;">
        <div class="modal-header">
            <div class="modal-title">🎨 AI CHARACTER PORTRAIT GENERATOR</div>
            <div style="display: flex; gap: 0.4rem; align-items: center;">
                @if (OnOpenSetup.HasDelegate)
                {
                    <button type="button" class="btn btn-secondary btn-sm" style="font-size: 0.7rem; padding: 0.2rem 0.5rem;" @onclick="HandleOpenSetup" title="Open Full System Setup">⚙️ Advanced Setup</button>
                }
                <button class="btn btn-secondary" style="padding: 0.2rem 0.5rem;" @onclick="Close">✕</button>
            </div>
        </div>
        <div class="modal-body">
            <p style="font-size: 0.75rem; color: var(--text-secondary);">
                Uses the engine selected below (synced from Setup → Imaging).
            </p>

            <div style="margin-bottom: 0.75rem;">
                <label class="form-label" style="font-size: 0.75rem; display: block; margin-bottom: 0.25rem;">Character:</label>
                <CustomSelect Value="@_selectedCharacterFile" ValueChanged="OnCharacterChanged" Options="_characterOptions" style="width: 100%;" />
            </div>

            <div style="display: grid; grid-template-columns: 1.2fr 1fr; gap: 0.5rem;">
                <div class="form-group" style="margin-bottom: 0.5rem;">
                    <label class="form-label" style="font-size: 0.68rem;">Image Engine:</label>
                    <CustomSelect Value="@_selectedEngine" ValueChanged="OnEngineChanged" Options="_engineOptions" />
                </div>
                <div class="form-group" style="margin-bottom: 0.5rem;">
                    <label class="form-label" style="font-size: 0.68rem;">Model / Checkpoint:</label>
                    <CustomSelect Value="@_selectedModel" ValueChanged="OnModelChanged" Options="_modelOptions" />
                </div>
            </div>

            <div style="font-size: 0.68rem; color: var(--accent-blue); margin-bottom: 0.5rem;">
                Active: <b>@_selectedEngine</b> / <b>@_selectedModel</b> / style <b>@_selectedArtStyle</b>
                @if (_settingsSynced)
                {
                    <span style="color: var(--accent-green);"> · from Setup settings</span>
                }
            </div>

            <div class="form-group" style="margin-bottom: 0.65rem;">
                <label class="form-label">Art style (shared with Scene artwork):</label>
                <div class="art-style-radio-grid" role="radiogroup" aria-label="Art style">
                    @foreach (var style in ImageArtStyleCatalog.All)
                    {
                        <label class="art-style-radio @(_selectedArtStyle == style.Id ? "selected" : "")" title="@style.Description">
                            <input type="radio"
                                   name="portrait-art-style"
                                   value="@style.Id"
                                   checked="@(_selectedArtStyle == style.Id)"
                                   @onchange="() => OnArtStyleChanged(style.Id)" />
                            <span class="art-style-radio-text">
                                <span class="art-style-name">@style.DisplayName</span>
                                <span class="art-style-desc">@style.Description</span>
                            </span>
                        </label>
                    }
                </div>
            </div>

            <div class="form-group">
                <label class="form-label">Appearance Prompt / Description:</label>
                <textarea class="form-control" rows="3" @bind="_prompt" placeholder="e.g. silver hair, ice-blue eyes, portrait..."></textarea>
            </div>

            @if (_isGenerating)
            {
                <div style="background: #0f172a; border: 1px solid var(--accent-purple); border-radius: 6px; padding: 1rem; text-align: center; margin-top: 0.5rem;">
                    <div style="font-size: 0.9rem; font-weight: 700; color: var(--accent-purple);">✨ Generating via @_selectedEngine…</div>
                    <div style="font-size: 0.72rem; color: var(--text-muted); margin-top: 0.3rem;">
                        Model: @_selectedModel · Style: @ImageArtStyleCatalog.GetById(_selectedArtStyle).DisplayName
                    </div>
                </div>
            }
            else if (!string.IsNullOrEmpty(_generatedImagePath))
            {
                <div style="background: #0f172a; border: 1px solid var(--accent-green); border-radius: 6px; padding: 0.75rem; text-align: center; margin-top: 0.5rem;">
                    <img src="@_generatedImagePath" style="max-width: 200px; height: auto; border-radius: 8px; border: 1px solid var(--border-highlight);" alt="Generated Portrait" />
                    <div style="font-size: 0.72rem; color: var(--accent-green); font-weight: 600; margin-top: 0.4rem;">
                        ✅ Ready · engine used: @_engineUsed
                    </div>
                </div>
            }

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <div style="color: var(--accent-rose); font-size: 0.75rem; font-weight: 600; margin-top: 0.4rem; white-space: pre-wrap;">@_errorMessage</div>
            }
        </div>
        <div class="modal-footer">
            <button class="btn btn-secondary" @onclick="Close">Cancel</button>
            <button class="btn btn-primary" disabled="@_isGenerating" @onclick="Generate">✨ Generate AI Art</button>
            @if (!string.IsNullOrEmpty(_generatedImagePath))
            {
                <button class="btn btn-success" @onclick="Apply">Apply &amp; Save ➔</button>
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public string SlotName { get; set; } = "Slot A";
    [Parameter] public EventCallback<string> OnPortraitGenerated { get; set; }
    [Parameter] public EventCallback OnClosed { get; set; }
    [Parameter] public EventCallback OnOpenSetup { get; set; }
    [Parameter] public string CharacterAppearance { get; set; } = "";
    [Parameter] public string CardFileName { get; set; } = "";

    private List<CustomSelect.DropdownOption> _engineOptions = new();
    private List<CustomSelect.DropdownOption> _modelOptions = new();
    private List<CustomSelect.DropdownOption> _characterOptions = new();
    private string _selectedCharacterFile = "";

    private string _selectedEngine = ImageEngineDetector.DefaultEngineId;
    private string _selectedModel = "flux";
    private string _selectedArtStyle = ImageArtStyleCatalog.DefaultStyleId;
    private string _prompt = "";
    private bool _isGenerating;
    private string _generatedImagePath = "";
    private byte[]? _generatedBytes;
    private string _generatedMime = "image/jpeg";
    private string _errorMessage = "";
    private string _cardId = "";
    private string _engineUsed = "";
    private bool _settingsSynced;

    protected override async Task OnInitializedAsync()
    {
        // Set initial character selection
        _selectedCharacterFile = CardFileName;
        
        // Load character list for dropdown
        LoadCharacterOptions();
        
        // Update cardId and prompt based on the initial character
        if (!string.IsNullOrEmpty(_selectedCharacterFile))
        {
            _cardId = CharacterCatalog.GetCardId(_selectedCharacterFile);
            if (string.IsNullOrEmpty(_cardId))
                _cardId = SlotName.ToLowerInvariant().Replace(" ", "_");
        }
        else
        {
            _cardId = SlotName.ToLowerInvariant().Replace(" ", "_");
        }

        // Use the passed appearance if available, otherwise try to get from character
        if (!string.IsNullOrEmpty(CharacterAppearance))
        {
            _prompt = CharacterAppearance;
        }
        else if (string.IsNullOrEmpty(_prompt))
        {
            // Try to get appearance from the selected character
            if (!string.IsNullOrEmpty(_selectedCharacterFile))
            {
                try
                {
                    var info = CharacterCatalog.LoadCardDetails(_selectedCharacterFile);
                    _prompt = CardFieldFormatter.BuildImagingPrompt(info.Physical, info.CharacterStyle, info.Name);
                }
                catch { }
            }
            if (string.IsNullOrEmpty(_prompt))
                _prompt = "solo character portrait, detailed physical appearance";
        }

        // Component is created fresh each time Index opens the modal (@if) —
        // always pull latest Setup → Imaging choice here.
        await SyncFromSettingsAndLoadAsync();
    }

    private async Task SyncFromSettingsAndLoadAsync()
    {
        // Prefer live context; fall back to disk so we never miss a just-saved Setup choice
        var settings = ControlContext?.CurrentSettings ?? AppConfigService.LoadSettings();
        if (settings != null)
        {
            if (!string.IsNullOrWhiteSpace(settings.ImageEngine))
                _selectedEngine = settings.ImageEngine.Trim();
            if (!string.IsNullOrWhiteSpace(settings.ImageModelIdentifier))
                _selectedModel = settings.ImageModelIdentifier.Trim();
            if (!string.IsNullOrWhiteSpace(settings.ImageArtStyle))
                _selectedArtStyle = ImageArtStyleCatalog.GetById(settings.ImageArtStyle).Id;
            _settingsSynced = true;
        }

        await LoadEngineOptionsAsync();
        await LoadModelOptionsAsync();
        StateHasChanged();
    }

    private void LoadCharacterOptions()
    {
        _characterOptions = new List<CustomSelect.DropdownOption>
        {
            new("", "(Select a character)")
        };
        
        try
        {
            // Use ListCardsFresh to ensure we get the latest from disk
            // (bypasses any stale SQLite cache)
            var catalog = CharacterCatalog.ListCardsFresh();
            foreach (var card in catalog)
            {
                _characterOptions.Add(new(card.FileName, card.DisplayName));
            }
        }
        catch
        {
            // Fallback to empty list
        }
    }

    private async Task OnCharacterChanged(string fileName)
    {
        _selectedCharacterFile = fileName;
        
        if (!string.IsNullOrEmpty(fileName))
        {
            _cardId = CharacterCatalog.GetCardId(fileName);
            
            try
            {
                var info = CharacterCatalog.LoadCardDetails(fileName);
                _prompt = CardFieldFormatter.BuildImagingPrompt(info.Physical, info.CharacterStyle, info.Name);
                
                // If still empty, use a default
                if (string.IsNullOrEmpty(_prompt))
                    _prompt = "solo character portrait, detailed appearance";
            }
            catch
            {
                _prompt = "solo character portrait, detailed appearance";
            }
        }
        
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadEngineOptionsAsync()
    {
        List<DetectedImageEngine> engines;
        try
        {
            engines = await ImageEngineDetector.DetectAvailableImageEnginesAsync(
                probeAgents: true, forceReprobe: false);
        }
        catch
        {
            engines = new List<DetectedImageEngine>
            {
                new(ImageEngineDetector.DefaultEngineId, "✨ Pollinations AI (Default)", true, "", ImageGeneratorEngine.PollinationsAI)
            };
        }

        _engineOptions = engines
            .Select(e => new CustomSelect.DropdownOption(e.Id, e.DisplayName))
            .ToList();

        // If Setup selected an engine that isn't in the detected list yet, keep it selectable
        // (do NOT force Coalesce back to Pollinations — that was wiping the user's choice).
        if (!_engineOptions.Any(o => o.Value.Equals(_selectedEngine, StringComparison.OrdinalIgnoreCase)))
        {
            _engineOptions.Insert(0, new(
                _selectedEngine,
                $"{_selectedEngine} (from Setup)"));
        }

        if (_engineOptions.Count == 0)
        {
            _engineOptions.Add(new(ImageEngineDetector.DefaultEngineId, "✨ Pollinations AI (Default)"));
            _selectedEngine = ImageEngineDetector.DefaultEngineId;
        }
    }

    private async Task LoadModelOptionsAsync()
    {
        try
        {
            var models = await ImageModelFetcher.GetModelsForEngineAsync(_selectedEngine, forceRefresh: false);
            _modelOptions = models
                .Select(m => new CustomSelect.DropdownOption(m.Id, m.DisplayName + (m.IsDefault ? " ✓" : "")))
                .ToList();
        }
        catch
        {
            _modelOptions = ImageModelFetcher.GetPollinationsModels()
                .Select(m => new CustomSelect.DropdownOption(m.Id, m.DisplayName))
                .ToList();
        }

        if (_modelOptions.Count == 0)
            _modelOptions.Add(new("flux", "flux"));

        if (!_modelOptions.Any(o => o.Value.Equals(_selectedModel, StringComparison.OrdinalIgnoreCase)))
        {
            // Keep setup model as option if missing
            _modelOptions.Insert(0, new(_selectedModel, $"{_selectedModel} (from Setup)"));
        }
    }

    private async Task OnEngineChanged(string val)
    {
        _selectedEngine = val;
        await LoadModelOptionsAsync();

        // When switching engines, pick that engine's default model if current isn't listed
        if (!_modelOptions.Any(o => o.Value.Equals(_selectedModel, StringComparison.OrdinalIgnoreCase)))
        {
            // Try to get the default model for this engine
            string defaultModel = await ImageModelFetcher.GetDefaultModelIdAsync(_selectedEngine);
            if (!_modelOptions.Any(o => o.Value.Equals(defaultModel, StringComparison.OrdinalIgnoreCase)))
            {
                defaultModel = _modelOptions.FirstOrDefault()?.Value ?? "flux";
            }
            _selectedModel = defaultModel;
        }

        // Persist both engine and model after model selection is complete
        PersistImagingChoice();

        StateHasChanged();
    }

    private void OnModelChanged(string val)
    {
        _selectedModel = val;
        PersistImagingChoice();
        StateHasChanged();
    }

    private void OnArtStyleChanged(string styleId)
    {
        _selectedArtStyle = ImageArtStyleCatalog.GetById(styleId).Id;
        PersistImagingChoice();
        StateHasChanged();
    }

    private void PersistImagingChoice()
    {
        try
        {
            var settings = ControlContext?.CurrentSettings ?? AppConfigService.LoadSettings() ?? new AppSettings();
            settings.ImageEngine = _selectedEngine;
            settings.ImageModelIdentifier = _selectedModel;
            settings.ImageArtStyle = _selectedArtStyle;
            ControlContext?.UpdateSettings(settings);
            _settingsSynced = true;
        }
        catch { }
    }

    private async Task Generate()
    {
        if (string.IsNullOrWhiteSpace(_prompt))
        {
            _errorMessage = "Please enter an appearance prompt description.";
            return;
        }

        // Final re-read of selection (user may have just changed dropdowns)
        string engineId = _selectedEngine;
        string modelId = _selectedModel;
        string artStyleId = _selectedArtStyle;
        var engineEnum = ImageEngineDetector.ParseEngineId(engineId);
        string styleName = ImageArtStyleCatalog.GetById(artStyleId).DisplayName;

        _isGenerating = true;
        using var busy = BusyTaskService.BeginTask("portrait_generation", $"Generating AI Portrait via {engineId} ({styleName})...");
        _errorMessage = "";
        _generatedBytes = null;
        _generatedImagePath = "";
        _engineUsed = $"{engineId} / {modelId} / {styleName}";
        StateHasChanged();

        try
        {
            // allowPollinationsFallback: false when user picked a non-default engine
            bool allowFallback = engineEnum == ImageGeneratorEngine.PollinationsAI;

            var result = await AiImageGeneratorService.GeneratePortraitDetailedAsync(
                _prompt,
                _cardId,
                engineEnum,
                default,
                modelId,
                allowPollinationsFallback: allowFallback,
                artStyleId: artStyleId);

            // Detect silent wrong-engine use
            bool looksLikeOnlyUrl = result.ImageBytes == null &&
                                    !string.IsNullOrEmpty(result.DisplayUri) &&
                                    result.DisplayUri.Contains("pollinations", StringComparison.OrdinalIgnoreCase);

            if (engineEnum != ImageGeneratorEngine.PollinationsAI && looksLikeOnlyUrl)
            {
                _errorMessage =
                    $"Engine '{engineId}' did not return image bytes. " +
                    "Output looked like a Pollinations URL / empty agent response.\n" +
                    "Check that the provider is running and passed image-emit detection in Setup → Imaging.";
                return;
            }

            if (result.ImageBytes == null || result.ImageBytes.Length == 0)
            {
                if (!string.IsNullOrEmpty(result.DisplayUri) &&
                    (result.DisplayUri.StartsWith("data:", StringComparison.OrdinalIgnoreCase) ||
                     result.DisplayUri.StartsWith("http", StringComparison.OrdinalIgnoreCase)))
                {
                    _generatedImagePath = result.DisplayUri;
                    _engineUsed = $"{engineId} / {modelId} / {styleName}";

                    if (CharacterPortraitService.HasStore && !string.IsNullOrEmpty(_cardId))
                    {
                        var saved = await CharacterPortraitService.SaveFromDataUriOrUrlAsync(
                            _cardId, _generatedImagePath, _prompt, engineId);
                        if (!string.IsNullOrEmpty(saved))
                            _generatedImagePath = saved;
                    }
                }
                else
                {
                    _errorMessage = $"No image returned from '{engineId}' (model '{modelId}').";
                    return;
                }
            }
            else
            {
                _generatedBytes = result.ImageBytes;
                _generatedMime = result.MimeType;
                _generatedImagePath = result.DisplayUri;
                _engineUsed = $"{engineId} / {modelId} / {styleName}";

                if (CharacterPortraitService.HasStore && !string.IsNullOrEmpty(_cardId))
                {
                    _generatedImagePath = CharacterPortraitService.SavePortrait(
                        _cardId, _generatedBytes, _generatedMime, _prompt, engineId);
                }
            }

            // Push to stage immediately so the character panel updates without a second click
            if (!string.IsNullOrEmpty(_generatedImagePath))
                await OnPortraitGenerated.InvokeAsync(_generatedImagePath);
        }
        catch (Exception ex)
        {
            _errorMessage = $"Generation failed ({engineId}): {ex.Message}";
        }
        finally
        {
            _isGenerating = false;
            StateHasChanged();
        }
    }

    private async Task Apply()
    {
        if (_generatedBytes is { Length: > 0 } && CharacterPortraitService.HasStore &&
            !string.IsNullOrEmpty(_cardId))
        {
            try
            {
                _generatedImagePath = CharacterPortraitService.SavePortrait(
                    _cardId, _generatedBytes, _generatedMime, _prompt, _selectedEngine);
            }
            catch { }
        }
        else if (!string.IsNullOrEmpty(_generatedImagePath) && CharacterPortraitService.HasStore &&
                 !string.IsNullOrEmpty(_cardId))
        {
            var saved = await CharacterPortraitService.SaveFromDataUriOrUrlAsync(
                _cardId, _generatedImagePath, _prompt, _selectedEngine);
            if (!string.IsNullOrEmpty(saved))
                _generatedImagePath = saved;
        }

        if (!string.IsNullOrEmpty(_generatedImagePath))
            await OnPortraitGenerated.InvokeAsync(_generatedImagePath);
    }

    private async Task HandleOpenSetup()
    {
        await OnOpenSetup.InvokeAsync();
    }

    private async Task Close()
    {
        // Keep stage portrait if we already applied on generate; empty close only dismisses modal
        await OnPortraitGenerated.InvokeAsync("");
        await OnClosed.InvokeAsync();
    }
}
