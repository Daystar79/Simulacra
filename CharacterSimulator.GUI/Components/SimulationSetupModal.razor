@inject TurnControlContext ControlContext
@inject IJSRuntime JS
@using System.Linq
@using CharacterSimulator.Logic.Services
@using Microsoft.AspNetCore.Components.Web

<div class="modal-overlay">
    <div class="modal-card" style="width: 580px;">
        <div class="modal-header">
            <div class="modal-title">⚙️ SIMULATION SETUP WIZARD</div>
            <button class="btn btn-secondary" style="padding: 0.2rem 0.5rem;" @onclick="Close">✕</button>
        </div>
        <div class="modal-body">
            <!-- TAB HEADER FOR SETTINGS -->
            <div class="panel-tabs-header" style="margin-bottom: 0.75rem;">
                <button class="panel-tab-btn @(ActiveSection == "Roleplaying" ? "active" : "")" @onclick='() => ActiveSection = "Roleplaying"'>
                    🎭 ROLEPLAYING SETTINGS
                </button>
                <button class="panel-tab-btn @(ActiveSection == "Imaging" ? "active" : "")" @onclick='() => ActiveSection = "Imaging"'>
                    🎨 IMAGING SETTINGS
                </button>
                <button class="panel-tab-btn @(ActiveSection == "Theme" ? "active" : "")" @onclick='() => ActiveSection = "Theme"'>
                    ✨ UI THEME
                </button>
            </div>

            @if (ActiveSection == "Roleplaying")
            {
                <p style="font-size: 0.75rem; color: var(--text-secondary);">Configure the Roleplay LLM engine, genre, scene context, and execution mode.</p>

                <div class="form-group">
                    <label class="form-label">Simulation Genre:</label>
                    <CustomSelect @bind-Value="_selectedGenre" Options="_genreOptions" />
                </div>

                <div class="form-group">
                    <label class="form-label">Initial Scene Context / Location:</label>
                    <textarea class="form-control" rows="2" @bind="_sceneContext" placeholder="Describe the scene setting..."></textarea>
                </div>

                <div class="form-group">
                    <label class="form-label">Execution Mode:</label>
                    <CustomSelect @bind-Value="_mode" Options="_modeOptions" />
                </div>

                <!-- ROLEPLAY LLM ENGINE SECTION -->
                <div style="background: #0f172a; border: 1px solid var(--accent-purple); border-radius: 6px; padding: 0.75rem; margin-top: 0.5rem;">
                    <div style="font-size: 0.75rem; font-weight: 700; color: var(--accent-purple); display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.4rem;">
                        <div style="display: flex; align-items: center; gap: 0.4rem;">
                            <span>🎭</span>
                            <span>ROLEPLAY &amp; DIALOGUE LLM ENGINE</span>
                        </div>
                        <button class="btn btn-secondary" style="padding: 0.15rem 0.4rem; font-size: 0.65rem;"
                                disabled="@_isDetecting" @onclick="DetectRoleplayEngines">
                            🔍 @(_isDetecting ? "Detecting…" : "Auto-Detect / Refresh")
                        </button>
                    </div>

                    <div style="display: grid; grid-template-columns: 1.2fr 1fr; gap: 0.5rem;">
                        <div class="form-group" style="margin-bottom: 0;">
                            <label class="form-label" style="font-size: 0.68rem;">Roleplay LLM Provider:</label>
                            <CustomSelect Value="@_selectedRoleplayLlmProvider"
                                          ValueChanged="OnRoleplayProviderChanged"
                                          Options="_llmProviderOptions" />
                        </div>
                        <div class="form-group" style="margin-bottom: 0;">
                            <label class="form-label" style="font-size: 0.68rem;">Model:</label>
                            <CustomSelect @bind-Value="_roleplayModelIdentifier" Options="_currentModelOptions" />
                        </div>
                    </div>

                    @if (_selectedRoleplayLlmProvider.Contains("SLM", StringComparison.OrdinalIgnoreCase) ||
                         _selectedRoleplayLlmProvider.Contains("LLamaSharp", StringComparison.OrdinalIgnoreCase))
                    {
                        <div style="background: rgba(30, 41, 59, 0.9); border: 1px solid var(--accent-blue); border-radius: 6px; padding: 0.5rem; margin-top: 0.5rem; font-size: 0.7rem;">
                            @if (!SlmModelDownloaderService.HasAnyGgufModel() && !_isDownloadingSlm)
                            {
                                <div style="display: flex; justify-content: space-between; align-items: center; gap: 0.5rem;">
                                    <span style="color: var(--accent-amber); font-weight: 600;">⚠️ No GGUF model found in Models/</span>
                                    <button class="btn btn-primary" style="padding: 0.2rem 0.5rem; font-size: 0.65rem;" @onclick="DownloadSlmModelAsync">
                                        📥 Download Default SLM (Qwen 2.5 3B ~2GB)
                                    </button>
                                </div>
                            }
                            else if (_isDownloadingSlm)
                            {
                                <div>
                                    <div style="display: flex; justify-content: space-between; margin-bottom: 0.2rem;">
                                        <span style="color: var(--accent-blue); font-weight: 600;">@_downloadProgressStatus</span>
                                        <span>@((_downloadProgressPercent * 100).ToString("F0"))%</span>
                                    </div>
                                    <div style="width: 100%; height: 6px; background: #334155; border-radius: 3px; overflow: hidden;">
                                        <div style="width: @((_downloadProgressPercent * 100).ToString("F0"))%; height: 100%; background: linear-gradient(90deg, var(--accent-blue), var(--accent-purple)); transition: width 0.2s;"></div>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div style="color: var(--accent-green); font-weight: 600; display: flex; align-items: center; gap: 0.4rem;">
                                    <span>✅ Embedded C# SLM Ready</span>
                                    <span style="color: var(--text-muted); font-weight: normal;">(@Path.GetFileName(LlamaSharpLlmClient.ResolveDefaultModelPath()))</span>
                                </div>
                            }
                        </div>
                    }

                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem; margin-top: 0.5rem;">
                        <div class="form-group" style="margin-bottom: 0;">
                            <label class="form-label">Temperature: @_temperature.ToString("F1")</label>
                            <input type="range" class="form-control" min="0.1" max="1.5" step="0.1" @bind="_temperature" style="padding: 0.2rem;" />
                        </div>
                        <div class="form-group" style="margin-bottom: 0;">
                            <label class="form-label">Max Response Tokens:</label>
                            <input type="number" class="form-control" min="128" max="4096" step="128" @bind="_maxTokens" />
                        </div>
                    </div>
                </div>
            }
            else
            {
                <p style="font-size: 0.75rem; color: var(--text-secondary);">Configure the AI Image Generator for character portraits and scene artwork.</p>

                <!-- IMAGING ENGINE SECTION -->
                <div style="background: #0f172a; border: 1px solid var(--accent-blue); border-radius: 6px; padding: 0.75rem;">
                    <div style="font-size: 0.75rem; font-weight: 700; color: var(--accent-blue); display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
                        <div style="display: flex; align-items: center; gap: 0.4rem;">
                            <span>🎨</span>
                            <span>CHARACTER &amp; SCENE IMAGE GENERATOR</span>
                        </div>
                        <button class="btn btn-secondary" style="padding: 0.15rem 0.4rem; font-size: 0.65rem;"
                                disabled="@_isDetectingImage" @onclick="DetectImageEngines">
                            🔍 @(_isDetectingImage ? "Detecting…" : "Auto-Detect / Refresh")
                        </button>
                    </div>

                    <div style="display: grid; grid-template-columns: 1.2fr 1fr; gap: 0.5rem;">
                        <div class="form-group" style="margin-bottom: 0;">
                            <label class="form-label" style="font-size: 0.68rem;">Image Engine Provider:</label>
                            <CustomSelect Value="@_selectedImageEngine"
                                          ValueChanged="OnImageEngineChanged"
                                          Options="_imageEngineOptions" />
                        </div>
                        <div class="form-group" style="margin-bottom: 0;">
                            <label class="form-label" style="font-size: 0.68rem;">Image Model / Checkpoint:</label>
                            <CustomSelect @bind-Value="_selectedImageModel" Options="_imageModelOptions" />
                        </div>
                    </div>

                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem; margin-top: 0.5rem;">
                        <div class="form-group">
                            <label class="form-label">Portrait Resolution:</label>
                            <input class="form-control" @bind="_imageResolution" placeholder="512x512" />
                        </div>
                        <div class="form-group">
                            <label class="form-label">Scene Resolution:</label>
                            <input class="form-control" value="1024x576" readonly />
                        </div>
                    </div>

                    <div style="font-size: 0.68rem; color: var(--text-muted); line-height: 1.4; margin-top: 0.4rem;">
                        * <b>Default:</b> Pollinations (free). Switch engine for higher quality when available.<br/>
                        * <b>Refresh</b> re-probes SD WebUI checkpoints and agent image-emit capability.<br/>
                        * Vision-only models never appear here (consume ≠ generate).
                    </div>
                </div>
            }

            @if (ActiveSection == "Theme")
            {
                <p class="theme-picker-intro">Choose a full chrome theme. Previews show canvas, panels, accent, and danger so you can compare before applying.</p>
                <div class="theme-picker-list">
                    @foreach (var theme in ThemeCatalog.All)
                    {
                        var selected = _selectedTheme == theme.Id;
                        <div class="theme-card-option @(selected ? "selected" : null)"
                             @onclick="() => SelectTheme(theme.Id)"
                             role="button"
                             tabindex="0"
                             @onkeydown="(e) => OnThemeKey(e, theme.Id)">
                            <div class="theme-card-preview" style="background: @theme.Surface0;">
                                <div class="theme-preview-chrome" style="background: @theme.Surface2;"></div>
                                <div class="theme-preview-body" style="background: @theme.Surface1;">
                                    <div class="theme-preview-bar" style="background: @theme.AccentColor;"></div>
                                    <div class="theme-preview-bar short" style="background: @theme.Surface2;"></div>
                                    <div class="theme-preview-btn" style="background: @theme.AccentColor;"></div>
                                </div>
                            </div>
                            <div class="theme-card-meta">
                                <div class="theme-card-title">
                                    <span>@theme.Icon</span>
                                    <span>@theme.DisplayName</span>
                                </div>
                                <div class="theme-card-desc">@theme.Description</div>
                                <div class="theme-card-swatches">
                                    <span class="theme-swatch" style="background: @theme.Surface0;" title="Canvas"></span>
                                    <span class="theme-swatch" style="background: @theme.Surface1;" title="Panel"></span>
                                    <span class="theme-swatch" style="background: @theme.AccentColor;" title="Accent"></span>
                                    <span class="theme-swatch" style="background: @theme.DangerColor;" title="Danger"></span>
                                </div>
                            </div>
                            <div class="theme-card-check">@(selected ? "✓" : "")</div>
                        </div>
                    }
                </div>
            }

            @if (!string.IsNullOrEmpty(_detectionStatus))
            {
                <div style="font-size: 0.68rem; color: var(--accent-green); font-weight: 600; margin-top: 0.4rem;">@_detectionStatus</div>
            }

            @if (!string.IsNullOrEmpty(_warningMessage))
            {
                <div style="color: var(--accent-amber); font-size: 0.72rem; font-weight: 600; margin-top: 0.4rem;">@_warningMessage</div>
            }
        </div>
        <div class="modal-footer">
            <button class="btn btn-secondary" @onclick="Close">Cancel</button>
            <button class="btn btn-success" @onclick="StartSimulation">🚀 Launch Simulation</button>
        </div>
    </div>
</div>

@code {
    [Parameter] public EventCallback<bool> OnClosed { get; set; }
    [Parameter] public string ActiveSection { get; set; } = "Roleplaying";

    private List<CustomSelect.DropdownOption> _genreOptions = new()
    {
        new("Contemporary", "Contemporary"),
        new("Cyberpunk", "Cyberpunk"),
        new("Sci-Fi", "Sci-Fi"),
        new("Fantasy", "Fantasy"),
        new("Noir", "Noir")
    };

    private List<CustomSelect.DropdownOption> _modeOptions = new()
    {
        new("AutoPlay", "🤖 Auto-Play Mode (Autonomous AI Roleplay)"),
        new("PlayerGuided", "🎮 Player-Guided Mode (Human Prompt Injected)")
    };

    private List<CustomSelect.DropdownOption> _llmProviderOptions = new()
    {
        new("AGY", "🚀 Antigravity AGY (Engine / CLI)"),
        new("Grok", "🧠 xAI Grok (API / CLI)"),
        new("MistralVibe", "⚡ Mistral Vibe (Local CLI)"),
        new("Ollama", "🦙 Ollama API (http://localhost:11434)"),
        new("MockEngine", "🧪 Mock LLM Engine (Offline Test)")
    };

    private List<CustomSelect.DropdownOption> _currentModelOptions = new()
    {
        new("agy-pro", "AGY Pro ✓")
    };

    private List<CustomSelect.DropdownOption> _imageEngineOptions = new()
    {
        new(ImageEngineDetector.DefaultEngineId, "✨ Pollinations AI (Default · free web API)")
    };

    private List<CustomSelect.DropdownOption> _imageModelOptions = new()
    {
        new("flux", "Flux (default quality) ✓")
    };

    private string _selectedCharA = "";
    private string _selectedCharB = "";
    private string _selectedGenre = "Contemporary";
    private string _sceneContext = "Quiet city apartment at midnight during a rainstorm.";
    private string _mode = "PlayerGuided";
    private string _selectedRoleplayLlmProvider = "AGY";
    private string _roleplayModelIdentifier = "agy-pro";
    private string _selectedImageEngine = ImageEngineDetector.DefaultEngineId;
    private string _selectedImageModel = "flux";
    private string _imageResolution = "512x512";
    private string _selectedTheme = ThemeCatalog.DefaultThemeId;
    private double _temperature = 0.7;
    private int _maxTokens = 1024;
    private string _detectionStatus = "";
    private string _warningMessage = "";
    private bool _isDetecting;
    private bool _isDetectingImage;

    protected override async Task OnInitializedAsync()
    {
        var saved = AppConfigService.LoadSettings();
        if (saved != null && saved.IsConfigured)
        {
            _selectedCharA = saved.SelectedCharA;
            _selectedCharB = saved.SelectedCharB;
            _selectedGenre = saved.SelectedGenre;
            _sceneContext = saved.ScenePrompt;
            _mode = saved.RoleplayMode;
            _selectedRoleplayLlmProvider = saved.RoleplayLlmProvider;
            _roleplayModelIdentifier = saved.RoleplayModelIdentifier;
            _temperature = saved.Temperature;
            _maxTokens = saved.MaxTokens;
            _selectedImageEngine = string.IsNullOrWhiteSpace(saved.ImageEngine)
                ? ImageEngineDetector.DefaultEngineId
                : saved.ImageEngine;
            _selectedImageModel = string.IsNullOrWhiteSpace(saved.ImageModelIdentifier)
                ? "flux"
                : saved.ImageModelIdentifier;
            _imageResolution = saved.ImageResolution;
            _selectedTheme = string.IsNullOrWhiteSpace(saved.UiTheme)
                ? ThemeCatalog.DefaultThemeId
                : saved.UiTheme;
        }

        // Populate both tabs without forcing agent image probes on every open (faster).
        await DetectRoleplayEngines(force: false);
        await DetectImageEngines(force: false);
    }

    private async Task OnRoleplayProviderChanged(string val)
    {
        _selectedRoleplayLlmProvider = val;
        await LoadModelOptionsAsync(forceRefresh: true);
        StateHasChanged();
    }

    private async Task OnImageEngineChanged(string val)
    {
        _selectedImageEngine = val;
        await LoadImageModelOptionsAsync(forceRefresh: true);
        StateHasChanged();
    }

    private async Task DetectRoleplayEngines() => await DetectRoleplayEngines(force: true);

    private async Task DetectRoleplayEngines(bool force)
    {
        _isDetecting = true;
        bool fromCache = !force && InstalledEngineStore.HasRoleplayCache();
        _detectionStatus = force
            ? "🔍 Scanning roleplay LLM providers + models…"
            : fromCache
                ? "📂 Loading roleplay engines from database…"
                : "🔍 Scanning roleplay LLM providers + models…";
        _warningMessage = "";
        StateHasChanged();

        try
        {
            var engines = await LlmEngineDetector.DetectAvailableEnginesAsync(forceRefresh: force);
            _llmProviderOptions = engines
                .Select(e => new CustomSelect.DropdownOption(
                    e.Id,
                    $"{e.DisplayName} ({(e.IsAvailable ? "✅" : "❌")})"))
                .ToList();

            if (_llmProviderOptions.Count == 0)
            {
                _llmProviderOptions = new List<CustomSelect.DropdownOption>
                {
                    new("MockEngine", "🧪 Mock LLM Engine (Offline)")
                };
            }

            // Keep saved provider if listed; else first available non-mock; else mock
            bool providerOk = _llmProviderOptions.Any(o => o.Value == _selectedRoleplayLlmProvider);
            if (!providerOk)
            {
                var available = engines.FirstOrDefault(e => e.IsAvailable && e.Id != "MockEngine");
                _selectedRoleplayLlmProvider = available?.Id ?? "MockEngine";
            }

            LlmModelFetcher.ClearCache(_selectedRoleplayLlmProvider);
            await LoadModelOptionsAsync(forceRefresh: force);

            string source = fromCache && !force ? "cached" : "scanned";
            _detectionStatus =
                $"✅ Roleplay ({source}): {_selectedRoleplayLlmProvider} · model: {_roleplayModelIdentifier} · {_currentModelOptions.Count} model option(s)";
        }
        catch (Exception ex)
        {
            _warningMessage = "Roleplay detect failed: " + ex.Message;
            // Hard fallback so dropdown is never empty
            _currentModelOptions = LlmModelFetcher.GetFallbackModels(_selectedRoleplayLlmProvider)
                .Select(m => new CustomSelect.DropdownOption(m.Id, m.DisplayName + (m.IsDefault ? " ✓" : "")))
                .ToList();
            if (_currentModelOptions.Count > 0 &&
                !_currentModelOptions.Any(o => o.Value == _roleplayModelIdentifier))
            {
                _roleplayModelIdentifier = _currentModelOptions[0].Value;
            }
        }
        finally
        {
            _isDetecting = false;
            StateHasChanged();
        }
    }

    private async Task DetectImageEngines() => await DetectImageEngines(force: true);

    private async Task DetectImageEngines(bool force)
    {
        _isDetectingImage = true;
        bool fromCache = !force && InstalledEngineStore.HasImageCache();
        _detectionStatus = force
            ? "🔍 Probing image engines (Pollinations + SD + agent emit)…"
            : fromCache
                ? "📂 Loading image engines from database…"
                : "🔍 Loading image engines…";
        _warningMessage = "";
        StateHasChanged();

        try
        {
            // force: re-run agent emit probes + rewrite DB; soft open uses SQLite cache when present
            var imageEngines = await ImageEngineDetector.DetectAvailableImageEnginesAsync(
                probeAgents: true,
                forceReprobe: force);

            _imageEngineOptions = imageEngines
                .Select(e => new CustomSelect.DropdownOption(e.Id, e.DisplayName))
                .ToList();

            if (_imageEngineOptions.Count == 0)
            {
                _imageEngineOptions = new List<CustomSelect.DropdownOption>
                {
                    new(ImageEngineDetector.DefaultEngineId, "✨ Pollinations AI (Default)")
                };
            }

            _selectedImageEngine = ImageEngineDetector.CoalesceToAvailable(_selectedImageEngine, imageEngines);

            ImageModelFetcher.ClearCache(_selectedImageEngine);
            await LoadImageModelOptionsAsync(forceRefresh: force);

            int agents = imageEngines.Count(e => e.Id.StartsWith("Agent", StringComparison.OrdinalIgnoreCase));
            string imgLabel = _selectedImageEngine == ImageEngineDetector.DefaultEngineId
                ? "Pollinations (default)"
                : _selectedImageEngine;
            string source = fromCache && !force ? "cached" : "scanned";
            _detectionStatus =
                $"✅ Imaging ({source}): {imgLabel} · model: {_selectedImageModel} · {_imageModelOptions.Count} option(s)" +
                (agents > 0 ? $" · {agents} agent image backend(s)" : "");
        }
        catch (Exception ex)
        {
            _warningMessage = "Image detect failed: " + ex.Message;
            _imageEngineOptions = new List<CustomSelect.DropdownOption>
            {
                new(ImageEngineDetector.DefaultEngineId, "✨ Pollinations AI (Default)")
            };
            _selectedImageEngine = ImageEngineDetector.DefaultEngineId;
            _imageModelOptions = ImageModelFetcher.GetPollinationsModels()
                .Select(m => new CustomSelect.DropdownOption(m.Id, m.DisplayName + (m.IsDefault ? " ✓" : "")))
                .ToList();
            _selectedImageModel = "flux";
        }
        finally
        {
            _isDetectingImage = false;
            StateHasChanged();
        }
    }

    private async Task LoadModelOptionsAsync(bool forceRefresh = false)
    {
        try
        {
            var models = await LlmModelFetcher.GetModelsForProviderAsync(
                _selectedRoleplayLlmProvider, forceRefresh);

            if (models.Count == 0)
                models = LlmModelFetcher.GetFallbackModels(_selectedRoleplayLlmProvider);

            _currentModelOptions = models
                .Select(m => new CustomSelect.DropdownOption(
                    m.Id,
                    m.DisplayName + (m.IsDefault ? " ✓" : "")))
                .ToList();

            if (_currentModelOptions.Count == 0)
            {
                _currentModelOptions = new List<CustomSelect.DropdownOption>
                {
                    new("default", "Default model")
                };
            }

            if (!_currentModelOptions.Any(o => o.Value == _roleplayModelIdentifier))
            {
                var def = models.FirstOrDefault(m => m.IsDefault) ?? models.FirstOrDefault();
                _roleplayModelIdentifier = def?.Id ?? _currentModelOptions[0].Value;
            }
        }
        catch
        {
            _currentModelOptions = LlmModelFetcher.GetFallbackModels(_selectedRoleplayLlmProvider)
                .Select(m => new CustomSelect.DropdownOption(m.Id, m.DisplayName + (m.IsDefault ? " ✓" : "")))
                .ToList();
            if (_currentModelOptions.Count > 0)
                _roleplayModelIdentifier = _currentModelOptions[0].Value;
        }

        StateHasChanged();
    }

    private async Task LoadImageModelOptionsAsync(bool forceRefresh = false)
    {
        try
        {
            var models = await ImageModelFetcher.GetModelsForEngineAsync(
                _selectedImageEngine, forceRefresh);

            _imageModelOptions = models
                .Select(m => new CustomSelect.DropdownOption(
                    m.Id,
                    m.DisplayName + (m.IsDefault ? " ✓" : "")))
                .ToList();

            if (_imageModelOptions.Count == 0)
            {
                _imageModelOptions = ImageModelFetcher.GetPollinationsModels()
                    .Select(m => new CustomSelect.DropdownOption(m.Id, m.DisplayName + (m.IsDefault ? " ✓" : "")))
                    .ToList();
            }

            if (!_imageModelOptions.Any(o => o.Value == _selectedImageModel))
            {
                var def = models.FirstOrDefault(m => m.IsDefault) ?? models.FirstOrDefault();
                _selectedImageModel = def?.Id ?? _imageModelOptions[0].Value;
            }
        }
        catch
        {
            _imageModelOptions = ImageModelFetcher.GetPollinationsModels()
                .Select(m => new CustomSelect.DropdownOption(m.Id, m.DisplayName + (m.IsDefault ? " ✓" : "")))
                .ToList();
            _selectedImageModel = "flux";
        }

        StateHasChanged();
    }

    private void StartSimulation()
    {
        SaveCurrentSettings();
        OnClosed.InvokeAsync(true);
    }

    private void SelectTheme(string themeId)
    {
        _selectedTheme = ThemeCatalog.GetById(themeId).Id;
        SaveCurrentSettings();
        // Live-apply so Setup preview matches chrome immediately
        _ = ApplyThemeLiveAsync(_selectedTheme);
    }

    private void OnThemeKey(KeyboardEventArgs e, string themeId)
    {
        if (e.Key is "Enter" or " ")
            SelectTheme(themeId);
    }

    private async Task ApplyThemeLiveAsync(string themeId)
    {
        try
        {
            await JS.InvokeVoidAsync("csTheme.apply", themeId);
        }
        catch
        {
            // theme.js may not be ready in rare boot races
        }
    }

    private bool _isDownloadingSlm;
    private double _downloadProgressPercent;
    private string _downloadProgressStatus = "";

    private async Task DownloadSlmModelAsync()
    {
        _isDownloadingSlm = true;
        _downloadProgressPercent = 0.01;
        _downloadProgressStatus = "Connecting...";
        StateHasChanged();

        bool ok = await Task.Run(() => SlmModelDownloaderService.DownloadDefaultModelAsync((pct, msg) =>
        {
            InvokeAsync(() =>
            {
                _downloadProgressPercent = pct;
                _downloadProgressStatus = msg;
                StateHasChanged();
            });
        }));

        _isDownloadingSlm = false;
        if (ok)
        {
            _detectionStatus = "✅ Qwen 2.5 3B GGUF Model downloaded & ready for local C# SLM roleplay!";
            await DetectRoleplayEngines(force: true);
        }
        else
        {
            _warningMessage = "Model download failed. Please check internet connection.";
        }
        StateHasChanged();
    }

    private void SaveCurrentSettings()
    {
        var settings = new AppSettings
        {
            SelectedCharA = _selectedCharA,
            SelectedCharB = _selectedCharB,
            SelectedGenre = _selectedGenre,
            ScenePrompt = _sceneContext,
            RoleplayMode = _mode,
            RoleplayLlmProvider = _selectedRoleplayLlmProvider,
            RoleplayModelIdentifier = _roleplayModelIdentifier,
            Temperature = _temperature,
            MaxTokens = _maxTokens,
            ImageEngine = _selectedImageEngine,
            ImageModelIdentifier = _selectedImageModel,
            ImageResolution = _imageResolution,
            UiTheme = _selectedTheme
        };
        ControlContext.UpdateSettings(settings);
    }

    private void Close()
    {
        SaveCurrentSettings();
        OnClosed.InvokeAsync(false);
    }
}
