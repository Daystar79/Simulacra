@* Center rail: dialogue / system / history *@

<div class="feed-panel">
    <div class="panel-tabs-header">
        <button class="panel-tab-btn @(CenterTab == "Dialogue" ? "active" : "")" @onclick='() => SwitchTab("Dialogue")'>
            💬 Dialogue
        </button>
        <button class="panel-tab-btn @(CenterTab == "System" ? "active" : "")" @onclick='() => SwitchTab("System")'>
            ⚙️ System
        </button>
        <button class="panel-tab-btn @(CenterTab == "History" ? "active" : "")" @onclick='() => SwitchTab("History")'>
            📜 History
        </button>
    </div>

    @if (CenterTab == "Dialogue")
    {
        <div class="feed-messages" id="dialogueFeed">
            @if (DialogueFeed.Count == 0)
            {
                <div class="chat-bubble chat-system">
                    <div class="dialogue-text">
                        Load a character on the right to auto-start, or restore last card then press ▶ Play.
                        Slash commands: /help /play /pause /step /stop /scene /clear /adult on
                    </div>
                </div>
            }
            @foreach (var msg in DialogueFeed)
            {
                <div class="chat-bubble @(msg.IsSystem ? "chat-system" : (msg.IsLeft ? "chat-left" : "chat-right"))">
                    @if (!msg.IsSystem)
                    {
                        <div class="chat-header">
                            <span class="speaker-name" style="@(string.IsNullOrEmpty(msg.SpeakerColor) ? null : $"color:{msg.SpeakerColor}")">@msg.SpeakerName @(string.IsNullOrEmpty(msg.TargetName) ? "" : "➔ " + msg.TargetName)</span>
                            <span title="@(string.IsNullOrEmpty(msg.SomaticText) ? "Emotion state" : $"Somatic tell: {msg.SomaticText}")">@msg.SpeakerEmotionEmoji</span>
                        </div>
                    }
                    @if (msg.IsSystem)
                    {
                        <div class="dialogue-text">@msg.Dialogue</div>
                    }
                    else
                    {
                        <div class="dialogue-segments">
                            @foreach (var seg in ParseDialogueSegments(msg.Dialogue))
                            {
                                if (seg.Type == SegmentType.Narration)
                                {
                                    <div class="narration-prose">@seg.Text</div>
                                }
                                else
                                {
                                    <div class="speech-block">
                                        <span class="speech-quote">“</span><span class="speech-text">@seg.Text</span><span class="speech-quote">”</span>
                                    </div>
                                }
                            }
                        </div>
                    }
                </div>
            }
        </div>

        <div class="player-input-bar">
            <input class="input-box"
                   placeholder="Type prompt or command (e.g. /step, /adult)..."
                   value="@PlayerInput"
                   @oninput="OnPlayerInputChanged"
                   @onkeyup="OnPlayerKeyUp" />
            <button class="btn btn-primary" @onclick="HandleSend">Send ➔</button>
        </div>
    }
    else if (CenterTab == "System")
    {
        <div class="panel-toolbar">
            <span class="section-title section-title-accent">⚙️ System diagnostics &amp; log</span>
            <button class="btn btn-secondary btn-sm" @onclick="HandleClearLogs">Clear</button>
        </div>
        <div class="output-log-container" id="outputLogBox">
            @foreach (var entry in OutputLogs)
            {
                <div class="log-entry @entry.LevelClass">
                    <span class="log-time">[@entry.Timestamp.ToString("HH:mm:ss")]</span>
                    <span class="log-message">@entry.Message</span>
                </div>
            }
        </div>
    }
    else
    {
        <div class="panel-toolbar">
            <span class="section-title">💬 Dialogue feed</span>
            <span class="panel-toolbar-meta">@DialogueFeed.Count messages</span>
        </div>
        <div class="output-log-container" id="historyLogBox">
            @for (int i = 0; i < DialogueFeed.Count; i++)
            {
                var turn = DialogueFeed[i];
                <div class="history-turn">
                    <div class="history-turn-title" style="@(string.IsNullOrEmpty(turn.SpeakerColor) ? null : $"color:{turn.SpeakerColor}")" title="@(string.IsNullOrEmpty(turn.SomaticText) ? "Turn" : $"Somatic tell: {turn.SomaticText}")">
                        @turn.SpeakerName @(turn.IsSystem ? "" : "➔ " + turn.TargetName)
                    </div>
                    @if (turn.IsSystem)
                    {
                        <div class="history-turn-body">@turn.Dialogue</div>
                    }
                    else
                    {
                        <div class="dialogue-segments">
                            @foreach (var seg in ParseDialogueSegments(turn.Dialogue))
                            {
                                if (seg.Type == SegmentType.Narration)
                                {
                                    <div class="narration-prose">@seg.Text</div>
                                }
                                else
                                {
                                    <div class="speech-block">
                                        <span class="speech-quote">“</span><span class="speech-text">@seg.Text</span><span class="speech-quote">”</span>
                                    </div>
                                }
                            }
                        </div>
                    }
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter] public string CenterTab { get; set; } = "Dialogue";
    [Parameter] public EventCallback<string> CenterTabChanged { get; set; }
    [Parameter] public List<ChatMessageModel> DialogueFeed { get; set; } = new();
    [Parameter] public List<LogEntryModel> OutputLogs { get; set; } = new();
    [Parameter] public string PlayerInput { get; set; } = "";
    [Parameter] public EventCallback<string> PlayerInputChanged { get; set; }
    [Parameter] public EventCallback OnSend { get; set; }
    [Parameter] public EventCallback OnClearLogs { get; set; }
    [Parameter] public EventCallback<KeyboardEventArgs> OnPlayerKeyUp { get; set; }

    private enum SegmentType { Narration, Speech }
    private record DialogueSegment(SegmentType Type, string Text);

    private static List<DialogueSegment> ParseDialogueSegments(string rawDialogue)
    {
        var segments = new List<DialogueSegment>();
        if (string.IsNullOrWhiteSpace(rawDialogue))
            return segments;

        // Clean leftover bracket tags and unwrap [Action] brackets
        rawDialogue = System.Text.RegularExpressions.Regex.Replace(rawDialogue, @"\[Somatic:?\s*.*?\]", "", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        rawDialogue = System.Text.RegularExpressions.Regex.Replace(rawDialogue, @"\[Goal:\s*.*?\]", "", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        rawDialogue = System.Text.RegularExpressions.Regex.Replace(rawDialogue, @"\[Image:\s*.*?\]", "", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        rawDialogue = System.Text.RegularExpressions.Regex.Replace(rawDialogue, @"\[\s*([^\]]+)\s*\]", "$1");
        rawDialogue = rawDialogue.Replace("[", "").Replace("]", "").Trim();

        var matches = System.Text.RegularExpressions.Regex.Matches(rawDialogue, @"(?:\*([^*]+)\*|_([^_]+)_|""([^""]+)""|([^""*_]+))");

        foreach (System.Text.RegularExpressions.Match m in matches)
        {
            string text = m.Value.Trim();
            if (string.IsNullOrWhiteSpace(text)) continue;

            if (m.Groups[1].Success || m.Groups[2].Success)
            {
                string content = (m.Groups[1].Success ? m.Groups[1].Value : m.Groups[2].Value).Trim();
                if (!string.IsNullOrEmpty(content))
                    segments.Add(new DialogueSegment(SegmentType.Narration, content));
            }
            else if (m.Groups[3].Success)
            {
                string content = m.Groups[3].Value.Trim();
                if (string.IsNullOrEmpty(content)) continue;

                if (IsLikelyActionProse(content))
                    segments.Add(new DialogueSegment(SegmentType.Narration, content));
                else
                    segments.Add(new DialogueSegment(SegmentType.Speech, content));
            }
            else
            {
                string content = text.Trim();
                if (string.IsNullOrEmpty(content)) continue;

                if (IsLikelySpokenDialogue(content))
                    segments.Add(new DialogueSegment(SegmentType.Speech, content));
                else
                    segments.Add(new DialogueSegment(SegmentType.Narration, content));
            }
        }

        return segments;
    }

    private static bool IsLikelyActionProse(string text)
    {
        string lower = text.ToLowerInvariant();
        return lower.StartsWith("i step") || lower.StartsWith("i reach") || lower.StartsWith("i turn")
            || lower.StartsWith("i pull") || lower.StartsWith("i lift") || lower.StartsWith("i look")
            || lower.StartsWith("a soft") || lower.StartsWith("my voice") || lower.StartsWith("my hand")
            || lower.StartsWith("my eyes") || lower.StartsWith("she ") || lower.StartsWith("he ");
    }

    private static bool IsLikelySpokenDialogue(string text)
    {
        if (text.EndsWith('?') || text.EndsWith('!'))
        {
            string lower = text.ToLowerInvariant();
            if (!lower.Contains("step") && !lower.Contains("reach") && !lower.Contains("turn") && !lower.Contains("pull"))
                return true;
        }
        return false;
    }

    private Task SwitchTab(string tab) => CenterTabChanged.InvokeAsync(tab);

    private Task OnPlayerInputChanged(ChangeEventArgs e) =>
        PlayerInputChanged.InvokeAsync(e.Value?.ToString() ?? "");

    private Task HandleSend() => OnSend.InvokeAsync();
    private Task HandleClearLogs() => OnClearLogs.InvokeAsync();
}
