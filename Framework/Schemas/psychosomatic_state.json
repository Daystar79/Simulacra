{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PsychosomaticStateSnapshot",
  "type": "object",
  "required": [
    "character_id",
    "autonomic_state",
    "affective_state",
    "subconscious_bias",
    "social_mask",
    "relational_vectors",
    "priority_arbitration"
  ],
  "properties": {
    "character_id": {
      "type": "string",
      "description": "Unique slug for the character"
    },
    "timestamp_or_movement": {
      "type": "string",
      "description": "Current movement ID, scene timestamp, or tick count"
    },
    "autonomic_state": {
      "type": "object",
      "required": [
        "polyvagal_mode",
        "cognitive_regime",
        "arousal",
        "stress",
        "fatigue",
        "primary_somatic_zones"
      ],
      "anyOf": [
        { "required": ["physical_pain", "emotional_distress", "physical_pain_tolerance", "emotional_distress_tolerance"] },
        { "required": ["pain"] }
      ],
      "properties": {
        "endocrine_state": {
          "type": "object",
          "description": "Tonic sex steroid indices and current stress hormone load.",
          "required": ["estradiol", "testosterone", "cortisol"],
          "properties": {
            "estradiol": { "type": "integer", "minimum": 0, "maximum": 100 },
            "testosterone": { "type": "integer", "minimum": 0, "maximum": 100 },
            "cortisol": { "type": "integer", "minimum": 0, "maximum": 100 }
          },
          "additionalProperties": false
        },
        "somatic_telemetry": {
          "type": "object",
          "description": "Relative simulation indices. Register shift is centered on 50.",
          "required": ["hrv", "peripheral_perfusion", "muscle_tension", "postural_bracing", "vocal_register", "register_shift", "energy_expenditure"],
          "properties": {
            "hrv": { "type": "integer", "minimum": 0, "maximum": 100 },
            "peripheral_perfusion": { "type": "integer", "minimum": 0, "maximum": 100 },
            "muscle_tension": { "type": "integer", "minimum": 0, "maximum": 100 },
            "postural_bracing": { "type": "integer", "minimum": 0, "maximum": 100 },
            "vocal_register": { "type": "integer", "minimum": 0, "maximum": 100 },
            "register_shift": { "type": "integer", "minimum": 0, "maximum": 100 },
            "energy_expenditure": { "type": "integer", "minimum": 0, "maximum": 100 }
          },
          "additionalProperties": false
        },
        "polyvagal_mode": {
          "type": "string",
          "enum": [
            "ventral_grounded",
            "sympathetic_mobilized",
            "dorsal_freeze",
            "dissociated_tunnel"
          ],
          "description": "Autonomic nervous mode: ventral (grounded/attuned), sympathetic (mobilized fight/flight), dorsal (shutdown/freeze), or dissociated (detached/tunnel vision)"
        },
        "cognitive_regime": {
          "type": "string",
          "enum": [
            "deliberative",
            "reactive"
          ],
          "description": "Operational cognitive circuit: 'deliberative' (cortical/regulated loop with arbitration, masking, and reasoned speech) vs 'reactive' (limbic short-circuit where acute emotional pressure or adrenaline bypasses arbitration into direct visceral reaction)"
        },
        "arousal": { "type": "integer", "minimum": 0, "maximum": 100, "description": "General autonomic activation." },
        "sexual_drive": { "type": "integer", "minimum": 0, "maximum": 100, "description": "Background sexual drive for an eligible adult character." },
        "orgasm": { "type": "boolean", "description": "True on the adult sexual pleasure threshold crossing that triggered an orgasm." },
        "orgasm_recovery": { "type": "integer", "minimum": 0, "maximum": 100, "description": "Recovery remaining, from 100 at onset to 0 at completion." },
        "lingering_arousal": { "type": "boolean", "description": "The current adult response is predominantly carried from an earlier tick." },
        "physical_pleasure": { "type": "integer", "minimum": 0, "maximum": 100, "description": "Current enjoyment of an ordinary bodily sensation." },
        "sexual_pleasure": { "type": "integer", "minimum": 0, "maximum": 100, "description": "Current felt sexual enjoyment for a confirmed adult. Independently assessed from arousal." },
        "sexual_excitation": { "type": "integer", "minimum": 0, "maximum": 100, "description": "Excitatory bodily signal before inhibition, including carried and sleep-related responses." },
        "sexual_inhibition": { "type": "integer", "minimum": 0, "maximum": 100, "description": "Current physiological damping of sexual excitation." },
        "sexual_arousal": { "type": "integer", "minimum": 0, "maximum": 100, "description": "Current physiological sexual arousal for an eligible adult character." },
        "visceral_revulsion": { "type": "integer", "minimum": 0, "maximum": 100, "description": "Current bodily revulsion following an appraisal of disgust." },
        "stress": { "type": "integer", "minimum": 0, "maximum": 100 },
        "fatigue": { "type": "integer", "minimum": 0, "maximum": 100, "description": "Accumulated physical fatigue." },
        "sleep_debt": { "type": "integer", "minimum": 0, "maximum": 100, "description": "Accumulated need for sleep." },
        "exhaustion": { "type": "integer", "minimum": 0, "maximum": 100, "description": "Severity derived from high physical fatigue or sleep debt." },
        "activity": { "type": "string", "enum": ["awake", "resting", "sleeping"], "description": "Current activity state supplied by the scene." },
        "exertion": { "type": "integer", "minimum": 0, "maximum": 100, "description": "Current physical effort while awake." },
        "hunger": { "type": "integer", "minimum": 0, "maximum": 100, "description": "Accumulated hunger relieved by food intake." },
        "cold_discomfort": { "type": "integer", "minimum": 0, "maximum": 100, "description": "Current felt cold, which adjusts over time toward the exposure level." },
        "cold_exposure": { "type": "integer", "minimum": 0, "maximum": 100, "description": "Current environmental cold exposure, with zero representing no exposure." },
        "heat_discomfort": { "type": "integer", "minimum": 0, "maximum": 100, "description": "Current felt heat, which adjusts over time toward the exposure level." },
        "heat_exposure": { "type": "integer", "minimum": 0, "maximum": 100, "description": "Current environmental heat exposure." },
        "noise_discomfort": { "type": "integer", "minimum": 0, "maximum": 100, "description": "Current sensory discomfort from noise and any lingering effects." },
        "noise_exposure": { "type": "integer", "minimum": 0, "maximum": 100, "description": "Current environmental noise exposure." },
        "bright_light_discomfort": { "type": "integer", "minimum": 0, "maximum": 100, "description": "Current sensory discomfort from bright light and any lingering effects." },
        "bright_light_exposure": { "type": "integer", "minimum": 0, "maximum": 100, "description": "Current environmental bright light exposure." },
        "pain": { "type": "integer", "minimum": 0, "maximum": 100, "description": "Legacy snapshot field for pain." },
        "physical_pain": { "type": "integer", "minimum": 0, "maximum": 100, "description": "Physical pain intensity. A value of 100 represents acute overload." },
        "emotional_distress": { "type": "integer", "minimum": 0, "maximum": 100, "description": "Emotional distress intensity." },
        "physical_pain_tolerance": { "type": "integer", "minimum": 0, "maximum": 100, "description": "Character tolerance for physical pain. Higher scores reduce its contribution to stress." },
        "emotional_distress_tolerance": { "type": "integer", "minimum": 0, "maximum": 100, "description": "Character tolerance for emotional distress. Higher scores reduce its contribution to stress." },
        "somatic_map": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": { "type": "integer", "minimum": 0, "maximum": 100 }
          }
        },
        "primary_somatic_zones": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "Z1_Cranial_Ocular",
              "Z2_Vocal_Cervical",
              "Z3_Thoracic_Respiratory",
              "Z4_Abdominal_Visceral",
              "Z5_Pelvic_Kinesthetic",
              "Z6_Peripheral_Grounding"
            ]
          }
        },
        "sensory_tunneling": {
          "type": "string",
          "description": "Obsessive fixation on a trivial sensory anchor during high stress or freeze (e.g. 'frayed hem of coat', 'ticking clock')"
        },
        "autonomic_surge": { "type": "boolean" },
        "involuntary_response": {
          "type": "string",
          "enum": ["none", "brace", "freeze"],
          "description": "Automatic bodily response already occurring in this snapshot."
        }
      }
    },
    "affective_state": {
      "type": "object",
      "required": [
        "primary_emotion",
        "secondary_emotion",
        "emotional_intensity",
        "impulse"
      ],
      "properties": {
        "emotions": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0, "maximum": 100 }
        },
        "initiative": { "type": "integer", "minimum": 0, "maximum": 100 },
        "release_state": { "type": "object" },
        "primary_emotion": { "type": "string" },
        "secondary_emotion": { "type": "string" },
        "emotional_intensity": { "type": "integer", "minimum": 0, "maximum": 100 },
        "impulse": {
          "type": "string",
          "description": "Raw un-thought-out reaction urge (flinch, reach, blurt, freeze, retreat)"
        },
        "ambivalence": {
          "type": "string",
          "description": "Simultaneous conflicting emotional impulses (e.g. 'craves connection while fearing exposure')"
        }
      }
    },
    "subconscious_bias": {
      "type": "object",
      "required": [
        "active_wound",
        "active_gift",
        "bias_state",
        "subconscious_visceral_truth",
        "conscious_rationalization",
        "defense_posture"
      ],
      "properties": {
        "active_wound": { "type": "string" },
        "active_gift": { "type": "string" },
        "bias_state": {
          "type": "string",
          "enum": ["DORMANT", "DEFENSIVE_ACTIVE", "GENERATIVE_ACTIVE"]
        },
        "perceptual_warp": {
          "type": "string",
          "description": "Subconscious reinterpretation of incoming input"
        },
        "subconscious_visceral_truth": {
          "type": "string",
          "description": "What the gut/body instinctively knows (e.g. 'Terrified of being discarded')"
        },
        "conscious_rationalization": {
          "type": "string",
          "description": "The ego's self-deceptive narrative justification (e.g. 'I am just being practical and saving time')"
        },
        "defense_posture": {
          "type": "string",
          "enum": [
            "none",
            "intellectualize",
            "fawn_placate",
            "deflect_banter",
            "cold_withdrawal",
            "preemptive_strike",
            "brace_stonewall"
          ],
          "description": "Active psychological survival stance under pressure"
        }
      }
    },
    "social_mask": {
      "type": "object",
      "required": ["facade_type", "mask_strain", "mask_fracture"],
      "properties": {
        "facade_type": {
          "type": "string",
          "description": "Social presentation style (e.g. 'cool_politeness', 'cheerful_competence', 'aloof_neutrality')"
        },
        "mask_strain": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "description": "Effort required to maintain social composure under pressure (0 = relaxed, 100 = near collapse)"
        },
        "mask_fracture": {
          "type": "boolean",
          "description": "Whether internal pressure causes the facade to crack this tick"
        },
        "fracture_tell": {
          "type": "string",
          "description": "The micro-leak where the mask slips (e.g. 'voice catches on syllable; knuckles blanch on desk')"
        }
      }
    },
    "relational_vectors": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "emotional_safety",
          "attraction_physical",
          "attraction_emotional",
          "respect_competence",
          "status_dynamic",
          "resentment_friction"
        ],
        "properties": {
          "intimacy": { "type": "integer", "minimum": 0, "maximum": 100 },
          "emotional_safety": { "type": "integer", "minimum": 0, "maximum": 100 },
          "attraction_physical": { "type": "integer", "minimum": 0, "maximum": 100 },
          "attraction_emotional": { "type": "integer", "minimum": 0, "maximum": 100 },
          "respect_competence": { "type": "integer", "minimum": 0, "maximum": 100 },
          "status_dynamic": {
            "type": "string",
            "enum": ["dominant", "yielding", "equals", "deference"]
          },
          "resentment_friction": { "type": "integer", "minimum": 0, "maximum": 100 },
          "relational_momentum": {
            "type": "string",
            "enum": [
              "building",
              "deepening",
              "stable",
              "eroding",
              "brittle",
              "suspended",
              "fractured"
            ],
            "description": "Directional velocity of the bond"
          },
          "relational_ambivalence": {
            "type": "string",
            "description": "Contradiction in relational feelings (e.g. 'craves praise from them but deeply resents their authority')"
          },
          "perceived_reciprocity": {
            "type": "object",
            "properties": {
              "perceived_liking": { "type": "integer", "minimum": 0, "maximum": 100 },
              "perceived_threat": { "type": "integer", "minimum": 0, "maximum": 100 }
            }
          },
          "relational_anchors": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "priority_arbitration": {
      "type": "object",
      "required": ["winning_drive", "salience_score", "competing_drives"],
      "properties": {
        "winning_drive": {
          "type": "string",
          "description": "Drive seizing top priority lock"
        },
        "salience_score": { "type": "integer", "minimum": 0, "maximum": 100 },
        "arbitration_status": {
          "type": "string",
          "enum": ["arbitrated", "bypassed_reactive", "impulse_override"],
          "description": "Whether drives were deliberated across weights ('arbitrated') or preempted by limbic emergency lock ('bypassed_reactive')"
        },
        "internal_friction": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "description": "Degree of cognitive dissonance and resistance between competing drives (0 = clear unity, 100 = paralyzed conflict)"
        },
        "competing_drives": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "drive_name": { "type": "string" },
              "salience": { "type": "integer" }
            }
          }
        }
      }
    },
    "output_vector": {
      "type": "object",
      "required": ["feels"],
      "properties": {
        "feels": {
          "type": "string",
          "description": "Somatic and visceral manifestations across 2+ body zones, including any involuntary response already occurring"
        },
        "thinks": {
          "type": "string",
          "description": "Internal monologue: reasoned rationalization in deliberative mode; fragmented sensory noise, visceral loop, or cognitive blank in reactive mode"
        },
        "says": {
          "type": "string",
          "description": "Optional dialogue intent supplied by the cognitive pipeline"
        },
        "does": {
          "type": "string",
          "description": "Optional action supplied by the cognitive pipeline"
        }
      }
    }
  }
}
